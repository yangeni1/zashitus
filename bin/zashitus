#!/bin/bash

# Zashitus CLI Manager
# Утилита для управления сервисом Zashitus

# Определяем реальный путь к директории проекта
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
PROJECT_ROOT="$(cd "$BIN_DIR/.." && pwd)"

PID_FILE="$PROJECT_ROOT/zashitus.pid"
LOG_FILE="$PROJECT_ROOT/server.log"
ENV_FILE="$PROJECT_ROOT/server/.env"

function start() {
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if ps -p $PID > /dev/null 2>&1; then
            echo "Zashitus уже запущен (PID: $PID)"
            return
        fi
        rm "$PID_FILE"
    fi

    echo "Запуск Zashitus..."
    cd "$PROJECT_ROOT"
    
    # Запускаем через корневой npm для корректной работы workspaces
    # Используем --prefix server или -w в зависимости от версии npm
    nohup npm start -w @zashitus/server > "$LOG_FILE" 2>&1 &
    NEW_PID=$!
    echo $NEW_PID > "$PID_FILE"
    
    # Даем серверу пару секунд на запуск и проверяем, не упал ли он
    sleep 2
    if ps -p $NEW_PID > /dev/null 2>&1; then
        echo "Сервис запущен успешно (PID: $NEW_PID)."
        echo "Адрес: http://localhost:3000"
        echo "Логи: $LOG_FILE"
    else
        echo "Ошибка: Сервис упал сразу после запуска."
        echo "Последние строки лога ($LOG_FILE):"
        tail -n 10 "$LOG_FILE"
        rm "$PID_FILE"
    fi
}

function stop() {
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if ps -p $PID > /dev/null 2>&1; then
            echo "Остановка Zashitus (PID: $PID)..."
            kill $PID
            echo "Сервис остановлен."
        else
            echo "Процесс $PID не найден."
        fi
        rm "$PID_FILE"
    else
        PIDS=$(pgrep -f "node src/index.js" || true)
        if [ ! -z "$PIDS" ]; then
             echo "Остановка процессов Zashitus: $PIDS"
             kill $PIDS
        else
             echo "Сервис не запущен."
        fi
    fi
}

function restart() {
    stop
    sleep 1
    start
}

function status() {
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if ps -p $PID > /dev/null 2>&1; then
            echo "Статус: Работает (PID: $PID)"
            echo "Адрес: http://localhost:3000"
            return
        fi
    fi
    echo "Статус: Остановлен"
}

function logs() {
    if [ -f "$LOG_FILE" ]; then
        tail -f "$LOG_FILE"
    else
        echo "Файл логов не найден."
    fi
}

function settings() {
    EDITOR_CMD=${EDITOR:-nano}
    if [ -f "$ENV_FILE" ]; then
        $EDITOR_CMD "$ENV_FILE"
    else
        echo "Файл настроек не найден: $ENV_FILE"
    fi
}

function help() {
    echo "Использование: zashitus [команда]"
    echo ""
    echo "Команды:"
    echo "  start     - Запустить сервис"
    echo "  stop      - Остановить сервис"
    echo "  restart   - Перезапустить сервис"
    echo "  status    - Проверить статус"
    echo "  logs      - Просмотр логов в реальном времени"
    echo "  settings  - Изменить настройки (.env)"
    echo "  help      - Показать эту справку"
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    status)
        status
        ;;
    logs)
        logs
        ;;
    settings)
        settings
        ;;
    help|--help|-h)
        help
        ;;
    *)
        if [ -z "$1" ]; then
            status
        else
            echo "Неизвестная команда: $1"
            help
            exit 1
        fi
        ;;
esac
