#!/bin/bash

# Zashitus CLI Manager
# Утилита для управления сервисом Zashitus

# Определяем реальный путь к директории проекта
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
PROJECT_ROOT="$(cd "$BIN_DIR/.." && pwd)"

PID_FILE="$PROJECT_ROOT/zashitus.pid"
LOG_FILE="$PROJECT_ROOT/server.log"
ENV_FILE="$PROJECT_ROOT/server/.env"

function start() {
    # 1. Сначала жестко чистим порт 3000, если он занят
    # Используем ss или netstat, если lsof нет
    OLD_PID=""
    if command -v lsof >/dev/null 2>&1; then
        OLD_PID=$(lsof -t -i:3000 || true)
    elif command -v fuser >/dev/null 2>&1; then
        OLD_PID=$(fuser 3000/tcp 2>/dev/null | awk '{print $NF}' || true)
    fi

    if [ ! -z "$OLD_PID" ]; then
        echo "Порт 3000 занят процессом $OLD_PID. Очистка..."
        kill -9 $OLD_PID || true
        sleep 2
    fi

    # 2. Удаляем старый PID файл
    rm -f "$PID_FILE"

    echo "Запуск Zashitus..."
    cd "$PROJECT_ROOT"
    
    # 3. Запускаем сервер через npm
    # Используем -w для запуска конкретного воркспейса
    nohup npm start -w @zashitus/server > "$LOG_FILE" 2>&1 &
    NEW_PID=$!
    echo $NEW_PID > "$PID_FILE"
    
    # 4. Проверка запуска
    sleep 3
    if ps -p $NEW_PID > /dev/null 2>&1; then
        echo "Сервис запущен успешно (PID: $NEW_PID)."
        echo "Адрес: http://localhost:3000"
    else
        echo "Ошибка: Сервис упал сразу после запуска."
        echo "Последние строки лога ($LOG_FILE):"
        if [ -f "$LOG_FILE" ]; then
            tail -n 20 "$LOG_FILE"
        fi
        rm -f "$PID_FILE"
    fi
}

function stop() {
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        echo "Остановка Zashitus (PID: $PID)..."
        kill $PID 2>/dev/null || kill -9 $PID 2>/dev/null || true
        rm -f "$PID_FILE"
    fi
    
    # Чистим порт на всякий случай
    PORT_PID=""
    if command -v lsof >/dev/null 2>&1; then
        PORT_PID=$(lsof -t -i:3000 || true)
    elif command -v fuser >/dev/null 2>&1; then
        PORT_PID=$(fuser 3000/tcp 2>/dev/null | awk '{print $NF}' || true)
    fi

    if [ ! -z "$PORT_PID" ]; then
        echo "Принудительная очистка порта 3000 (PID: $PORT_PID)..."
        kill -9 $PORT_PID 2>/dev/null || true
    fi
    echo "Сервис остановлен."
}

function restart() {
    stop
    sleep 2
    start
}

function status() {
    PID=""
    if command -v lsof >/dev/null 2>&1; then
        PID=$(lsof -t -i:3000 || true)
    elif command -v fuser >/dev/null 2>&1; then
        PID=$(fuser 3000/tcp 2>/dev/null | awk '{print $NF}' || true)
    fi

    if [ ! -z "$PID" ]; then
        echo "Статус: Работает (PID: $PID)"
        echo "Адрес: http://localhost:3000"
    else
        echo "Статус: Остановлен"
    fi
}

function logs() {
    if [ -f "$LOG_FILE" ]; then
        tail -f "$LOG_FILE"
    else
        echo "Файл логов не найден."
    fi
}

function settings() {
    EDITOR_CMD=${EDITOR:-nano}
    if [ -f "$ENV_FILE" ]; then
        $EDITOR_CMD "$ENV_FILE"
    else
        echo "Файл настроек не найден: $ENV_FILE"
    fi
}

function help() {
    echo "Использование: zashitus [команда]"
    echo ""
    echo "Команды:"
    echo "  start     - Запустить сервис"
    echo "  stop      - Остановить сервис"
    echo "  restart   - Перезапустить сервис"
    echo "  status    - Проверить статус"
    echo "  logs      - Просмотр логов в реальном времени"
    echo "  settings  - Изменить настройки (.env)"
    echo "  help      - Показать эту справку"
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    status)
        status
        ;;
    logs)
        logs
        ;;
    settings)
        settings
        ;;
    help|--help|-h)
        help
        ;;
    *)
        if [ -z "$1" ]; then
            status
        else
            echo "Неизвестная команда: $1"
            help
            exit 1
        fi
        ;;
esac
