#!/bin/bash

# Zashitus CLI Manager
# Утилита для управления сервисом Zashitus

# Определяем реальный путь к директории проекта, даже если запущен через симлинк
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
PROJECT_ROOT="$(cd "$BIN_DIR/.." && pwd)"

PID_FILE="$PROJECT_ROOT/zashitus.pid"
ENV_FILE="$PROJECT_ROOT/server/.env"

function start() {
    if [ -f "$PID_FILE" ]; then
        if ps -p $(cat "$PID_FILE") > /dev/null 2>&1; then
            echo "Zashitus уже запущен (PID: $(cat "$PID_FILE"))"
            return
        fi
        rm "$PID_FILE"
    fi

    echo "Запуск Zashitus..."
    cd "$PROJECT_ROOT/server"
    # Запускаем через npm start, логи сохраняем в корне проекта
    nohup npm start > "$PROJECT_ROOT/server.log" 2>&1 &
    echo $! > "$PID_FILE"
    echo "Сервис запущен в фоновом режиме."
    echo "Адрес: http://localhost:3000 (по умолчанию)"
    echo "Логи: $PROJECT_ROOT/server.log"
}

function stop() {
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if ps -p $PID > /dev/null 2>&1; then
            echo "Остановка Zashitus (PID: $PID)..."
            kill $PID
            echo "Сервис остановлен."
        else
            echo "Процесс $PID не найден, очистка pid-файла."
        fi
        rm "$PID_FILE"
    else
        # На всякий случай ищем процесс по имени, если pid-файл пропал
        PIDS=$(pgrep -f "node src/index.js" || true)
        if [ -not -z "$PIDS" ]; then
             echo "Остановка процессов Zashitus: $PIDS"
             kill $PIDS
        else
             echo "Сервис не запущен."
        fi
    fi
}

function restart() {
    stop
    sleep 2
    start
}

function status() {
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if ps -p $PID > /dev/null 2>&1; then
            echo "Статус: Работает (PID: $PID)"
            echo "Адрес: http://localhost:3000"
            return
        fi
    fi
    echo "Статус: Остановлен"
}

function settings() {
    EDITOR_CMD=${EDITOR:-nano}
    if [ -f "$ENV_FILE" ]; then
        $EDITOR_CMD "$ENV_FILE"
    else
        echo "Файл настроек не найден по пути: $ENV_FILE"
        echo "Попробуйте запустить установку заново или создать файл вручную."
    fi
}

function help() {
    echo "Использование: zashitus [команда]"
    echo ""
    echo "Команды:"
    echo "  start     - Запустить сервис"
    echo "  stop      - Остановить сервис"
    echo "  restart   - Перезапустить сервис"
    echo "  status    - Проверить статус"
    echo "  settings  - Изменить настройки (.env)"
    echo "  help      - Показать эту справку"
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    status)
        status
        ;;
    settings)
        settings
        ;;
    help|--help|-h)
        help
        ;;
    *)
        if [ -z "$1" ]; then
            status
        else
            echo "Неизвестная команда: $1"
            help
            exit 1
        fi
        ;;
esac
